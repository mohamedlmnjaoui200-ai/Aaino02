{
  "version": 2,
  "builds": [{ "src": "index.js", "use": "@vercel/node" }],
  "routes": [
    { "src": "/", "dest": "/index.js?route=root" },
    { "src": "/health", "dest": "/index.js?route=health" },
    { "src": "/setup", "dest": "/index.js?route=setup" },
    { "src": "/webhook/main", "dest": "/index.js?route=main" },
    { "src": "/webhook/child/([^/]+)", "dest": "/index.js?route=child&id=$1" }
  ]
}
