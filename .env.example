# توكن بوت "الصانع" الرئيسي (من @BotFather)
MAIN_BOT_TOKEN=123456789:AAxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# عنوان تطبيق Azure (HTTPS وبدون / في النهاية)
BASE_URL=https://YOUR-APP-NAME.azurewebsites.net

# مفتاح تشفير التوكنات (نص عشوائي طويل - لا تغيّره بعد الاستخدام)
ENCRYPTION_KEY=change-me-to-a-long-random-string

# سر الـ webhooks (نص عشوائي طويل)
WEBHOOK_SECRET=change-me-to-another-long-random-string

# اختياري: معرّفك الرقمي لاستخدام /stats
ADMIN_ID=

# اختياري: true لإعادة ربط جميع البوتات بعد تغيير BASE_URL
RESYNC_WEBHOOKS=false
